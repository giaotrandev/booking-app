<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>Bus Ticket</title>
    <style>
      body {
        font-family: 'Arial', sans-serif;
        width: 80mm;
        margin: 0;
        padding: 0;
        font-size: 12px;
        line-height: 1.3;
        background: white;
        color: #000;
      }
      
      .ticket {
        border: 2px solid #000;
        border-radius: 8px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        overflow: hidden;
      }
      
      .header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 12px;
        text-align: center;
        position: relative;
      }
      
      .logo {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        border: 2px solid white;
        margin: 0 auto 8px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      
      .logo img {
        width: 40px;
        height: 40px;
        object-fit: contain;
      }
      
      .company-name {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      
      .ticket-type {
        font-size: 11px;
        opacity: 0.9;
        text-transform: uppercase;
      }
      
      .content {
        padding: 12px;
      }
      
      .ticket-number {
        text-align: center;
        background: #f1f3f4;
        margin: -12px -12px 12px -12px;
        padding: 8px 12px;
        border-bottom: 1px dashed #ccc;
        font-weight: bold;
        font-size: 11px;
        color: #555;
      }
      
      .passenger-info {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
      }
      
      .passenger-name {
        font-size: 14px;
        font-weight: bold;
        color: #1e3c72;
        text-transform: uppercase;
        margin-bottom: 3px;
      }
      
      .route-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
      }
      
      .route-text {
        font-size: 13px;
        font-weight: bold;
        color: #333;
        flex: 1;
      }
      
      .arrow {
        margin: 0 4px;
        color: #1e3c72;
        font-weight: bold;
      }
      
      .trip-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 10px;
      }
      
      .detail-item {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 4px;
        padding: 8px;
        text-align: center;
      }
      
      .detail-label {
        font-size: 9px;
        color: #666;
        text-transform: uppercase;
        font-weight: bold;
        display: block;
      }
      
      .detail-value {
        font-size: 12px;
        color: #000;
        font-weight: bold;
        margin-top: 2px;
      }
      
      .location-info {
        margin-bottom: 10px;
      }
      
      .location-item {
        background: #fff;
        border-left: 3px solid #1e3c72;
        padding: 8px 10px;
        margin-bottom: 8px;
        font-size: 11px;
      }
      
      .location-label {
        color: #666;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 9px;
        margin-bottom: 4px;
      }
      
      .station-name {
        color: #1e3c72;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 12px;
        margin-bottom: 3px;
      }
      
      .station-address {
        color: #666;
        font-size: 10px;
        line-height: 1.3;
        height: 39px; /* Fixed height for 3 lines */
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }
      
      .qr-section {
        text-align: center;
        padding: 10px;
        background: #fff;
        border: 1px dashed #ccc;
        border-radius: 6px;
        margin-top: 10px;
      }
      
      .qr-code {
        width: 50mm;
        height: 50mm;
        margin: 0 auto;
        border: 1px solid #e0e0e0;
      }
      
      .scan-text {
        font-size: 9px;
        color: #666;
        margin-top: 6px;
        text-transform: uppercase;
      }
      
      .footer {
        background: #f1f3f4;
        padding: 8px 12px;
        text-align: center;
        font-size: 9px;
        color: #666;
        border-top: 1px dashed #ccc;
        margin: 10px -12px -12px -12px;
      }
      
      .perforated-edge {
        position: relative;
      }
      
      .perforated-edge::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background-image: radial-gradient(circle, #ccc 50%, transparent 50%);
        background-size: 4px 2px;
        background-repeat: repeat-x;
      }
    </style>
  </head>
  <body>
    <div class='ticket'>
      <div class='header'>
        {{#if logoPath}}
        <div class='logo'>
          <img src='{{logoPath}}' alt='Company Logo' />
        </div>
        {{/if}}
        <div class='company-name'>{{companyName}}</div>
        <div class='ticket-type'>Bus Ticket</div>
      </div>
      
      <div class='content'>
        <div class='ticket-number perforated-edge'>
          Ticket #{{ticketNumber}}
        </div>
        
        <div class='passenger-info'>
          <div class='passenger-name'>{{passengerName}}</div>
        </div>
        
        <div class='route-info'>
          <div class='route-text'>{{routeName}}</div>
        </div>
        
        <div class='trip-details'>
          <div class='detail-item'>
            <span class='detail-label'>Departure</span>
            <div class='detail-value'>{{departureTime}}</div>
          </div>
          <div class='detail-item'>
            <span class='detail-label'>Seat</span>
            <div class='detail-value'>{{seatNumbers}}</div>
          </div>
        </div>
        
        {{#if pickupName}}
        <div class='location-info'>
          <div class='location-item'>
            <div class='location-label'>🚌 Pickup Point</div>
            <div class='station-name'>{{pickupName}}</div>
            <div class='station-address'>{{pickupAddress}}</div>
          </div>
          {{#if dropoffName}}
          <div class='location-item'>
            <div class='location-label'>🏁 Drop-off Point</div>
            <div class='station-name'>{{dropoffName}}</div>
            <div class='station-address'>{{dropoffAddress}}</div>
          </div>
          {{/if}}
        </div>
        {{/if}}
        
        {{#if qrCodePath}}
        <div class='qr-section'>
          <img src='{{qrCodePath}}' alt='Ticket QR Code' class='qr-code' />
          <div class='scan-text'>Scan for validation</div>
        </div>
        {{/if}}
      </div>
      
      <div class='footer'>
        Please arrive 15 minutes before departure • Keep this ticket until journey ends
      </div>
    </div>
  </body>
</html>